+"$PY" -m trace_seg3d.preprocess utsw --root "$S/raw/PKG - UTSW-Glioma/UTSW-Glioma" \
+  --metadata "$S/raw/UTSW_Glioma_Metadata-2-1.tsv" --out "$S/proc/utsw" --size 48 --workers 2
